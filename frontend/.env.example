# Optional: collector URL when UI is hosted on a different origin.
# VITE_API_BASE_URL=https://metrics-api.example.com

# Local dev: proxied /metrics Authorization when collector uses API_TOKEN.
VITE_DEV_API_TOKEN=YOUR_API_TOKEN

# Phase 7b — browser OIDC (Okta or any OIDC issuer).
# VITE_OIDC_AUTHORITY=https://your-org.okta.com/oauth2/default
# VITE_OIDC_CLIENT_ID=your-spa-client-id
# VITE_OIDC_REDIRECT_URI=http://localhost:5173/callback
# VITE_OIDC_SCOPE=openid profile email
