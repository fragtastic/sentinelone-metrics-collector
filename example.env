SENTINELONE_AUTH_TOKEN=YOUR_TOKEN_HERE
SENTINELONE_URL=YOUR_CONSOLE_HERE

# SentinelOne upstream pacing (defaults are conservative for count API).
# MAX_QUERY_WORKERS=2
# S1_QUERY_STAGGER_SECONDS=0.5
# S1_HTTP_CONNECT_TIMEOUT_SECONDS=5
# S1_HTTP_READ_TIMEOUT_SECONDS=45
# S1_QUERY_RETRIES=1
# S1_QUERY_RETRY_DELAY_SECONDS=2

# Optional: shared secret for Excel/scripts (Authorization: Bearer on /metrics/*).
# API_TOKEN=YOUR_METRICS_API_TOKEN_HERE

# Optional: verify OIDC access tokens from browser SSO (issuer URL, no trailing slash).
# OIDC_ISSUER=https://your-org.okta.com/oauth2/default
# OIDC_AUDIENCE=api://metrics-collector

# Optional: allow split-origin UI (comma-separated origins).
# CORS_ALLOWED_ORIGINS=https://metrics-ui.example.com

# When SentinelOne count fails: null (insert row with NULL Result) or omit (no row). Default: null
# STORE_FAILED_AS=null
